<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleDisplayName</key>
	<string>Xi Lite AI</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Xi Lite records your voice so Groq can transcribe it and send it to the AI assistant.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Xi Lite uses on-device speech recognition for voice input with non-Groq providers.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Xi Lite connects to the account server you configure for sign-in and Pro status.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.xilite.ai</string>
			<key>CFBundleURLSchemes</key>
			<array><string>xiliteai</string></array>
		</dict>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
</dict>
</plist>
